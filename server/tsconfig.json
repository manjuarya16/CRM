{
  "compilerOptions": {
    "rootDir": "./src",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "baseUrl": ".",
    "paths": {
      "@src/*": [
        "src/*",
        "dist/*"
      ],
      "@/*": [
        "src/*",
        "dist/*"
      ]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "lib": [
      "esnext"
    ],
    "sourceMap": false,
    "declaration": false,
    "noEmit": false,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
