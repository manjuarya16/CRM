# Application Config
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL / pgAdmin Database Configuration
# Option 1: Full Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_db

# Option 2: Individual Connection Parameters (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=crm_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_crm_database_2026!
JWT_EXPIRES_IN=7d

# Initial Admin User Seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
